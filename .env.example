# 이 파일을 복사해서 `.env` 를 만들고, 값만 채우면 됩니다.
#
#   cp .env.example .env
#
# `.env` 는 .gitignore 에 있어서 깃에 올라가지 않습니다.
# 실제 키는 이 파일(.env.example)이 아니라 `.env` 에만 넣으세요.

# ── Gemini API 키 ──────────────────────────────────────────────
# https://aistudio.google.com/apikey 에서 발급.
# 없어도 앱은 켜집니다 — 사진 분석 / 코디 추천 / 가상 착용만 503 이 되고,
# 옷장 등록·조회·수동 코디는 그대로 동작합니다.
GEMINI_API_KEY=

# ── JWT 서명 키 ────────────────────────────────────────────────
# 32바이트(=32자) 이상이어야 합니다. 짧으면 서버가 뜨다가 멈춥니다.
# 아무 문자열이나 길게 적으면 되고, 아래 명령으로 만들어도 됩니다.
#   openssl rand -base64 48
#
# 이 값이 바뀌면 이미 발급된 토큰이 전부 무효가 됩니다(다시 로그인하면 됩니다).
ORBIT_JWT_SECRET=

# ── 선택 ───────────────────────────────────────────────────────
# 사진이 저장될 위치. 비워두면 프로젝트 안 ./data/media 에 쌓입니다.
# ORBIT_MEDIA_DIR=./data/media

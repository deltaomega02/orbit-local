# cp .env.example .env 후 값을 채운다. .env 는 gitignore 대상이다.

# Gemini API 키 (https://aistudio.google.com/apikey)
# 없으면 사진 분석·코디 추천·가상 착용만 503 이 되고 나머지는 동작한다.
GEMINI_API_KEY=

# JWT 서명 키. 32바이트 이상이 아니면 기동에 실패한다.
#   openssl rand -base64 48
# 값이 바뀌면 발급된 토큰은 모두 무효가 된다.
ORBIT_JWT_SECRET=

# 선택: 사진 저장 위치. 비우면 OS 별 사용자 데이터 폴더를 쓴다.
# ORBIT_MEDIA_DIR=./data/media
